{
  "name": "dsh-zh-ui",
  "version": "0.2.0",
  "description": "Chinese UI design spec for DeepSeek Harness: a zh-ui-design skill with CJK typography rules and style presets, project DESIGN.md / design.tokens.json injection, and a static zh_design_lint tool.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "design-system",
    "cjk",
    "typography",
    "lint"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-working-directory": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^20.19.43",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1186258278/dsh-zh-ui.git"
  },
  "homepage": "https://github.com/1186258278/dsh-zh-ui#readme",
  "bugs": {
    "url": "https://github.com/1186258278/dsh-zh-ui/issues"
  }
}
